# ============================================================
# GHG All Analyses — .gitignore
# ============================================================
# Only Python scripts and this file are tracked.
# Everything else (data, outputs, drafts, cache) is excluded.
# ============================================================


# ------------------------------------------------------------
# RAW & PROCESSED DATA — licensed EDGAR source data
# EDGAR data has usage restrictions; never commit to public repo
# ------------------------------------------------------------
data/
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.feather
*.pkl
*.pickle

# Catch any stray CSV placed outside data/
GHG_Persistence_Study/GHG_totals_by_country.csv


# ------------------------------------------------------------
# OUTPUTS — reproducible from scripts; can be large files
# ------------------------------------------------------------
outputs/

# Figures
*.png
*.pdf
*.tiff
*.tif
*.jpg
*.jpeg
*.svg
*.eps

# Tables and reports
*.xlsx
*.xls
*.xlsm
*.txt


# ------------------------------------------------------------
# MANUSCRIPT DRAFTS — confidential until published
# ------------------------------------------------------------
*.docx
*.doc
*.odt
*.rtf

# Common manuscript folder names
manuscript/
drafts/
submission/
revision/
Introduction/
Methodology/
Discussion/
Supplementary/


# ------------------------------------------------------------
# CREDENTIALS & ENVIRONMENT — never commit secrets
# ------------------------------------------------------------
.env
.env.*
*.env
secrets.yaml
secrets.json
credentials*
config/secrets*


# ------------------------------------------------------------
# PYTHON — virtual environments & cache
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/


# ------------------------------------------------------------
# JUPYTER
# ------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb


# ------------------------------------------------------------
# OS-GENERATED FILES
# ------------------------------------------------------------
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
._*

# Linux
*~


# ------------------------------------------------------------
# IDE & EDITOR
# ------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.spyderproject
*.spyproject
.ropeproject/


# ------------------------------------------------------------
# LOGS & TEMP
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo


# ------------------------------------------------------------
# WHAT IS TRACKED (for reference)
#   GHG_Persistence_Study/scripts/*.py   — all analysis scripts
#   .gitignore                           — this file
# ------------------------------------------------------------
