# Ignore everything by default
*

# Do not ignore directories (needed to traverse into subdirectories)
!*/

# Keep this file tracked
!.gitignore

# Allow only Python scripts
!GHG_Trajectory_Analysis_Study/scripts/*.py

# Allow README and requirements
!GHG_Trajectory_Analysis_Study/README.md
!GHG_Trajectory_Analysis_Study/requirements.txt

# Allow output tables
!GHG_Trajectory_Analysis_Study/outputs/tables/Analysis_Trajectory Classification.xlsx
!GHG_Trajectory_Analysis_Study/outputs/tables/Sensitivity Analysis_Threshold.xlsx
!GHG_Trajectory_Analysis_Study/outputs/tables/Sensitivity Analysis_Sample Composition.xlsx
